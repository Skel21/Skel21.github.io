---
interface Props {
    title: string;
    date: string;
    description: string;
    photoSrc: string;
    url: string;
}

const props = Astro.props as Props;
---
<a href={props.url} target="_blank" class="highlight-item aspect-[4/5] bg-neutral-800 rounded overflow-hidden group cursor-pointer">
    <div class="highlight-image w-full h-full relative">
        
        <div class="w-full h-full flex items-center justify-center text-neutral-600 bg-neutral-800">
            <img src={props.photoSrc} alt="" class="w-full h-full object-cover">
        </div>
        <div class="highlight-text">
            <p class="text-xs text-neutral-500 mb-2">{props.date}</p>
            <h3 class="text-xl font-light text-neutral-50 mb-3">
                {props.title}
            </h3>
            <p class="text-sm text-neutral-400 leading-relaxed">
                {props.description}
            </p>
        </div>
    </div>
</a>