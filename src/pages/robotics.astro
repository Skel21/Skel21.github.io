---
import "../styles/global.css";
import ResearchItem from "../components/ResearchItem.astro";
import SideProject from "../components/SideProject.astro";
import HighlightsItem from "../components/HighlightsItem.astro";
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bartłomiej Leks</title>
</head>
<body class="bg-neutral-900 text-neutral-300 antialiased">
    
    <header class="border-b border-neutral-800">
        <div class="max-w-5xl mx-auto px-8 py-24 md:py-36">
            <div class="fade-in">
                <div class="flex flex-col md:flex-row md:items-start md:gap-12">
                    
                    <div class="flex-grow">
                        <h1 class="text-5xl md:text-6xl font-light tracking-tight text-neutral-50 mb-8 leading-tight">
                            Bartłomiej Leks
                        </h1>
                        <p class="text-xl text-neutral-400 max-w-2xl leading-relaxed font-light">
                        Master's student at ETH Zurich. I train neural networks end-to-end and build numerical simulations for physics research.
                        <br/>
                        Now looking to bring that to robot learning.
                        </p>
                    </div>
                    
                    <div class="flex-shrink-0 mt-12 md:mt-0">
                        <img src="/photo_adamed.png" alt="Bartłomiej Leks profile photo" 
                            class="w-40 h-40 md:w-56 md:h-56 object-cover rounded-full border-2 border-neutral-700 shadow-xl mx-auto md:mx-0 opacity-80">
                    </div>
                </div>
                <div class="flex flex-wrap gap-8 mt-12 text-sm">
                    <a href="mailto:lbartlomiej@student.ethz.ch" 
                       class="text-neutral-500 hover:text-white transition-colors duration-300">
                        Email
                    </a>
                    <a href="https://linkedin.com/in/bartlomiej-leks" 
                       target="_blank"
                       class="text-neutral-500 hover:text-white transition-colors duration-300">
                        LinkedIn
                    </a>
                    <a href="https://github.com/skel21" 
                       target="_blank"
                       class="text-neutral-500 hover:text-white transition-colors duration-300">
                        GitHub
                    </a>
                </div>
            </div>
        </div>
    </header>

    <section class="py-24 md:py-36 border-b border-neutral-800">
        <div class="max-w-5xl mx-auto px-8">
            <h2 class="text-sm font-medium text-neutral-500 uppercase tracking-wider mb-16">Research & Experience</h2>
            <div class="space-y-20">
                <ResearchItem
                    title="Symmetry Informed Machine Learning for Molecular Dynamics"
                    date="2024-25"
                    description1="Built and trained a graph neural network with built-in symmetry constraints, integrated into a Python/C++ molecular dynamics pipeline."
                    description2=""
                    contributors="Dr Shashank Saxena, Prof. Dennis Kochmann"
                    place="ETH Zurich"
                    tags={["Graph Neural Networks", "PyTorch", "Python/C++", "HPC"]}
                />

                <ResearchItem
                    title="Machine Learning Engineer"
                    date="2023-24"
                    description1="Designed and deployed ML pipelines for user behavior analytics. Built full-stack tools in Python and Vue.js."
                    description2=""
                    contributors=""
                    place="Intellectus.app"
                    tags={["Machine Learning", "Python", "Full-stack"]}
                />

                <ResearchItem
                    title="Non-abelian Fractional Topological Insulators in Moiré Materials (Master's Thesis)"
                    date="now"
                    description1="Built large-scale numerical code (exact diagonalization) to study a complex quantum system, with diagnostics to extract phases from data."
                    description2=""
                    contributors="Dr. Glenn Wagner, Prof. Peter Derlet"
                    place="ETH Zurich"
                    tags={["Exact Diagonalization", "Moiré Systems", "Python"]}
                />

                <ResearchItem
                    title="Fracton Physics in Twisted Bilayer Graphene"
                    date="2025"
                    description1="Used tensor networks (DMRG) and analytical methods to map the phase diagram of a correlated quantum system."
                    description2=""
                    contributors="Dr. Dan Mao, Prof. Titus Neupert"
                    place="University of Zurich"
                    tags={["Tensor Networks", "Julia"]}
                />

                <ResearchItem
                    title="Ab-initio Study of Band Structure in Transition Metal Dichalcogenides"
                    date="2024"
                    description1="Built DFT and tight-binding code to study electronic band structures, benchmarked against experimental data."
                    description2=""
                    contributors="Prof. Witold Bardyszewski"
                    place="University of Warsaw"
                    tags={["DFT+U", "Python"]}
                />
            </div>
        </div>
    </section>

    <section class="py-24 md:py-36 border-b border-neutral-800">
        <div class="max-w-5xl mx-auto px-8">
            <h2 class="text-sm font-medium text-neutral-500 uppercase tracking-wider mb-16">Highlights</h2>
            
            <div class="grid md:grid-cols-2 gap-6">
                <HighlightsItem
                    title="Topology and Entanglement in Interacting Quantum Matter"
                    date="February 2026"
                    description="Took part in an amazing conference in Benasque, Spain, focused on theoretical advances in tensor networks, topological matter, quantum computing and entanglement."
                    url="https://benasque.org/2026etqm/"
                    photoSrc="https://journals.aps.org/prb/article/10.1103/PhysRevB.106.195132/deliverable/4e6ebbdc-0521-4da1-8202-4979d3f9c93a"
                />

                <HighlightsItem
                    title="Young Physicists Forum (YPF) Co-organization"
                    date="November 2025"
                    description="Co-organized the annual student forum at ETH Zurich focused this time on Quantum Science and Technology. The weekend event fostered exchange and networking among physics students from all Swiss universities through inspiring lectures and social activities."
                    url="https://www.young-physicists.ch"
                    photoSrc="/ypf.jpeg"
                />

                <HighlightsItem
                    title="Theory Talks Presentation"
                    date="2025"
                    description="Presented a talk '1D Chains as a Window into Fractionalized Graphene States' at ETH's seminar series. The presentation covered the use of Bethe Ansatz, bosonization, and DMRG to study one-dimensional models relevant to fracton physics in twisted bilayer graphene."
                    url="https://theorytalks.ethz.ch/student-talks/"
                    photoSrc="/theory_talks.jpg"
                />
            </div>
        </div>
    </section>

    <section class="py-24 md:py-36 border-b border-neutral-800">
        <div class="max-w-5xl mx-auto px-8">
            <h2 class="text-sm font-medium text-neutral-500 uppercase tracking-wider mb-16">Side Projects</h2>
            
            <div class="space-y-8">
                <SideProject
                    title="XY Model Simulation"
                    projectUrl="https://github.com/Skel21/xy-model"
                    demoUrl="https://skel21.github.io/xy-model/"
                    description="Performance-focused C++ simulation of the classical 2D XY spin model with Monte Carlo updates."
                    tags={["C++", "Monte Carlo"]}
                />
                <SideProject
                    title="Allocentric Flocking Simulation"
                    projectUrl="https://github.com/Skel21/allocentric-flocking-with-predator"
                    description="Agent-based flocking model in Python, using ring attractor networks for decision-making under predator pressure."
                    tags={["Python", "Agent-based Simulation"]}
                />
                <SideProject
                    title="Gravner-Griffeath Snowflake Simulator"
                    projectUrl="https://github.com/Skel21/gg-snowflakes"
                    demoUrl="https://skel21.github.io/gg-snowflakes/"
                    description="High-performance C++ cellular automaton for realistic snowflake crystal growth."
                    tags={["C++", "Cellular Automata"]}
                />
            </div>
        </div>
    </section>

    <footer class="py-16">
        <div class="max-w-5xl mx-auto px-8 text-center text-neutral-600 text-xs">
            <p>Zürich, Switzerland</p>
            <p>Last updated: April 2026</p>
        </div>
    </footer>
</body>
</html>