---
import "../styles/global.css";
import ResearchItem from "../components/ResearchItem.astro";
import SideProject from "../components/SideProject.astro";
import HighlightsItem from "../components/HighlightsItem.astro";
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bartłomiej Leks</title>
</head>
<body class="bg-neutral-900 text-neutral-300 antialiased">
    
    <header class="border-b border-neutral-800">
        <div class="max-w-5xl mx-auto px-8 py-24 md:py-36">
            <div class="fade-in">
                <div class="flex flex-col md:flex-row md:items-start md:gap-12">
                    
                    <div class="flex-grow">
                        <h1 class="text-5xl md:text-6xl font-light tracking-tight text-neutral-50 mb-8 leading-tight">
                            Bartłomiej Leks
                        </h1>
                        <p class="text-xl text-neutral-400 max-w-2xl leading-relaxed font-light">
                        Master's student at ETH Zurich studying Quantum and Condensed Matter Physics.
                        <br/>
                        I work at the intersection of theory and computation, using analytic methods and numerical simulations.
                        <br/>
                        Currently exploring topological matter, fractons, tensor networks, and symmetry-aware ML.
                        </p>
                    </div>
                    
                    <div class="flex-shrink-0 mt-12 md:mt-0">
                        <img src="/photo_adamed.png" alt="Bartłomiej Leks profile photo" 
                            class="w-40 h-40 md:w-56 md:h-56 object-cover rounded-full border-2 border-neutral-700 shadow-xl mx-auto md:mx-0 opacity-80">
                    </div>
                </div>
                <div class="flex flex-wrap gap-8 mt-12 text-sm">
                    <a href="mailto:lbartlomiej@student.ethz.ch" 
                       class="text-neutral-500 hover:text-white transition-colors duration-300">
                        Email
                    </a>
                    <a href="https://linkedin.com/in/bartlomiej-leks" 
                       target="_blank"
                       class="text-neutral-500 hover:text-white transition-colors duration-300">
                        LinkedIn
                    </a>
                    <a href="https://github.com/skel21" 
                       target="_blank"
                       class="text-neutral-500 hover:text-white transition-colors duration-300">
                        GitHub
                    </a>
                    <a href="https://skel21.github.io/leks-cv/general.pdf" 
                       target="_blank"
                       class="text-neutral-500 hover:text-white transition-colors duration-300">
                        CV
                    </a>
                </div>
            </div>
        </div>
    </header>

    <section class="py-24 md:py-36 border-b border-neutral-800">
        <div class="max-w-5xl mx-auto px-8">
            <h2 class="text-sm font-medium text-neutral-500 uppercase tracking-wider mb-16">Research</h2>
            <div class="space-y-20">

                <ResearchItem
                title="Fracton Physics in Twisted Bilayer Graphene"
                date="2025"
                description1="Working on understanding lineon excitations in magic-angle twisted bilayer graphene at one-third filling. Using tensor networks (DMRG) to study the low-energy physics, correlations and phase transitions, combined with analytical methods like Bethe Ansatz and bosonization."
                description2="The goal is to connect simplified 1D models to the more complex 2D physics of fractionalized states in moiré heterostructures. Presented this work at ETH's Theory Talks seminar."
                contributors="Dr. Dan Mao, Prof. Titus Neupert"
                place="University of Zurich"
                tags={["Tensor Networks", "Moiré Systems", "Topological Phases", "Julia"]}
                />

                <ResearchItem
                title="Symmetry Informed Machine Learning for Molecular Dynamics"
                date="2024-25"
                description1="Developed molecular dynamics software using equivariant graph neural networks to optimize force field predictions."
                description2="The project focused on developing efficient ML models that respect physical E(3) symmetries, and optimizing them for HPC environments and for incorporation into molecular dynamics simulations."
                contributors="Dr Shashank Saxena, Prof. Dennis Kochmann"
                place="ETH Zurich"
                tags={["Graph Neural Networks", "Python/C++", "HPC"]}
                />

                <ResearchItem
                title="Ab-initio Study of Band Structure in Transition Metal Dichalcogenides"
                date="2024"
                description1="Developed own DFT and tight-binding code and used it, along with Quantum ESPRESSO, to study electronic band structures of transition metal dichalcogenides (TMDs)."
                description2="Focused on understanding the effects of different atoms on bandgap and band topology, comparing results to benchmark computational methods and to select materials for photophysical applications."
                contributors="Prof. Witold Bardyszewski"
                place="University of Warsaw"
                tags={["DFT+U", "Tight Binding", "Python", "Quantum ESPRESSO"]}
                />
            </div>
        </div>
    </section>

    <section class="py-24 md:py-36 border-b border-neutral-800">
        <div class="max-w-5xl mx-auto px-8">
            <h2 class="text-sm font-medium text-neutral-500 uppercase tracking-wider mb-16">Highlights</h2>
            
            <div class="grid md:grid-cols-2 gap-6">
                <HighlightsItem
                    title="Young Physicists Forum (YPF) Co-organization"
                    date="November 2025"
                    description="Co-organized the annual student forum at ETH Zurich focused this time on Quantum Science and Technology. The weekend event fostered exchange and networking among physics students from all Swiss universities through inspiring lectures and social activities."
                    url="https://www.young-physicists.ch"
                    photoSrc="/ypf.jpeg"
                />

                <HighlightsItem
                    title="Theory Talks Presentation"
                    date="2025"
                    description="Presented a talk '1D Chains as a Window into Fractionalized Graphene States' at ETH's seminar series. The presentation covered the use of Bethe Ansatz, bosonization, and DMRG to study one-dimensional models relevant to fracton physics in twisted bilayer graphene."
                    url="https://theorytalks.ethz.ch/student-talks/"
                    photoSrc="/theory_talks.jpg"
                />
            </div>
        </div>
    </section>

    <section class="py-24 md:py-36 border-b border-neutral-800">
        <div class="max-w-5xl mx-auto px-8">
            <h2 class="text-sm font-medium text-neutral-500 uppercase tracking-wider mb-16">Side Projects</h2>
            
            <div class="space-y-8">
                <SideProject
                    title="Gravner-Griffeath Snowflake Simulator"
                    projectUrl="https://github.com/Skel21/gg-snowflakes"
                    demoUrl="https://skel21.github.io/gg-snowflakes/"
                    description="A high performance implementation of the Gravner-Griffeath cellular automaton model for realistic snowflake crystal growth. The simulation core is written in C++ and compiled with Emscripten for smooth, in-browser execution."
                    tags={["C++", "WebAssembly (Emscripten)", "Cellular Automata"]}
                />
                <SideProject
                    title="XY Model Simulation"
                    projectUrl="https://github.com/Skel21/xy-model"
                    demoUrl="https://skel21.github.io/xy-model/"
                    description="A C++ implementation of the classical 2D XY spin model, with Monte Carlo updates. Compiled to WebAssembly via Emscripten for interactive web visualization."
                    tags={["C++", "WebAssembly (Emscripten)", "Monte Carlo"]}
                />
                <SideProject
                    title="Allocentric Flocking Simulation"
                    projectUrl="https://github.com/Skel21/allocentric-flocking-with-predator"
                    description="A Python implementation of Allocentric flocking modeled by a ring attractor networks. Represents brain of a bird in a flock as a circle of coupled spins, with interactions favouring alignment and monte-carlo updates simulating decision-making. Made for a network science course at ETH Zurich."
                    tags={["Python"]}
                />
        </div>
    </section>
